{
  "name": "aplicacion-sas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs && .venv/bin/python -m unittest discover -s tests -p 'test_import_sas_bank.py'",
    "test:import": ".venv/bin/python -m unittest discover -s tests -p 'test_import_sas_bank.py'",
    "import:exam": ".venv/bin/python scripts/import_sas_exam.py",
    "import:bank": ".venv/bin/python scripts/import_sas_bank.py",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "TMPDIR=.cache/tmp PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@playwright/test": "1.62.1",
    "vite": "8.2.1"
  }
}
