{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/sas-exam.schema.json",
  "title": "SAS exam",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "source", "questions"],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": ["string", "null"]
    },
    "year": {
      "type": ["integer", "null"],
      "minimum": 2000,
      "maximum": 2100
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionPdf", "sha256"],
      "properties": {
        "questionPdf": {
          "type": "string",
          "minLength": 1
        },
        "answersPdf": {
          "type": ["string", "null"]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topicId",
        "topicLabel",
        "subtopic",
        "explanation",
        "optionFeedback",
        "confidence",
        "status",
        "model",
        "promptVersion",
        "reviewedAt"
      ],
      "properties": {
        "topicId": {
          "type": ["string", "null"]
        },
        "topicLabel": {
          "type": ["string", "null"]
        },
        "subtopic": {
          "type": ["string", "null"]
        },
        "explanation": {
          "type": ["string", "null"]
        },
        "optionFeedback": {
          "type": "object",
          "patternProperties": {
            "^[A-Z]$": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "enum": ["ai_generated", "reviewed", "flagged", "source_grounded", "not_generated"]
        },
        "model": {
          "type": ["string", "null"]
        },
        "promptVersion": {
          "type": ["string", "null"]
        },
        "reviewedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "text",
        "options",
        "correctOption",
        "status",
        "topic",
        "sourcePage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-q[0-9]{3,4}$"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "correctOption": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]$"
        },
        "status": {
          "enum": ["valid", "annulled", "reserve", "needs_review"]
        },
        "topic": {
          "type": ["string", "null"]
        },
        "sourcePage": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "learning": {
          "$ref": "#/$defs/learning"
        }
      }
    }
  }
}
